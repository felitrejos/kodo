# Copy to .env (git-ignored) and fill in to sign and notarize releases.
# Without these, scripts/release.sh still builds an unsigned .dmg.

# The full name of your Developer ID Application certificate, as shown by
# `security find-identity -v -p codesigning`.
DEVELOPER_ID_APPLICATION="Developer ID Application: Your Name (TEAMID1234)"

# Notarization: your Apple ID, team ID, and an app-specific password
# from account.apple.com → Sign-In and Security → App-Specific Passwords.
APPLE_ID=you@example.com
APPLE_TEAM_ID=TEAMID1234
APPLE_APP_SPECIFIC_PASSWORD=abcd-efgh-ijkl-mnop
